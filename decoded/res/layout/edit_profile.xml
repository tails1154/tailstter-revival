<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <include android:id="@id/navbar" layout="@layout/navbar" />
    <ScrollView android:layout_width="fill_parent" android:layout_height="fill_parent" android:layout_above="@id/toolbar" android:layout_below="@id/navbar">
        <LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="wrap_content">
            <RelativeLayout android:paddingLeft="12.0dip" android:paddingTop="12.0dip" android:paddingRight="10.0dip" android:layout_width="fill_parent" android:layout_height="wrap_content">
                <ImageView android:id="@id/profile_image" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginRight="10.0dip" />
                <TextView android:textStyle="bold" android:id="@id/name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toRightOf="@id/profile_image" />
                <TextView android:id="@id/screen_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toRightOf="@id/profile_image" android:layout_below="@id/name" />
            </RelativeLayout>
            <RelativeLayout android:layout_width="fill_parent" android:layout_height="wrap_content" style="@style/ButtonBar">
                <Button android:id="@id/change_profile_image" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/profile_change_photo" android:onClick="onClickHandler" style="@style/Button" />
            </RelativeLayout>
            <View android:background="@drawable/list_rule" android:layout_width="fill_parent" android:layout_height="1.0px" />
            <TextView android:text="@string/profile_name_title" style="@style/Profile.Title.Edit" />
            <EditText android:id="@id/edit_name" style="@style/Profile.Edit" />
            <TextView android:text="@string/profile_description_title" style="@style/Profile.Title.Edit" />
            <EditText android:id="@id/edit_bio" style="@style/Profile.Edit" />
            <TextView android:text="@string/profile_url_title" style="@style/Profile.Title.Edit" />
            <EditText android:id="@id/edit_web" style="@style/Profile.Edit" />
            <TextView android:text="@string/profile_location_title" style="@style/Profile.Title.Edit" />
            <EditText android:id="@id/edit_location" style="@style/Profile.Edit" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:gravity="center" android:id="@id/toolbar" android:layout_alignParentBottom="true" style="@style/Toolbar">
        <Button android:id="@id/done" android:layout_width="@dimen/toolbar_button_width" android:layout_height="wrap_content" android:text="@string/done" android:onClick="onClickHandler" style="@style/Button" />
    </LinearLayout>
</RelativeLayout>